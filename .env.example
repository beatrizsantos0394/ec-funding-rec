# Copy to .env and fill in. Never commit the real .env.
# THESIS_PROJECT_DIR should point at the *root* of this project (the folder
# containing config.py) — everything in config.py is relative to it.
THESIS_PROJECT_DIR=/path/to/thesis_project

# NOTE: this is OPEN_AI_API_KEY (with an underscore), matching what's
# already set as a system environment variable on the author's machine.
# If you already have it set at the system/Windows level, you do NOT need
# to also put it here -- os.getenv() will find the system one. Only add
# it here if you'd rather manage it per-project instead of system-wide.
OPEN_AI_API_KEY=
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_CHAT_DEPLOYMENT=gpt-5.4
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# After setting THESIS_PROJECT_DIR, run once:
#   python scripts/setup_data_folder.py --source "/path/to/your/downloads"
